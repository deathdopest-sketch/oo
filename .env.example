# ó_ò — environment variables
# Copy to .env and fill in your values.
# Lines starting with # are comments — remove them from your .env if you want it clean.

# ─── Platform ──────────────────────────────────────────────────────────────────
# Which platform(s) to connect to.
# 'chatcommon' | 'mumblechat' | 'both'
OO_PLATFORM=both

# ─── ChatCommon ────────────────────────────────────────────────────────────────
# Registered account credentials (must NOT be a Guest account)
CHATCOMMON_USERNAME=
CHATCOMMON_PASSWORD=

# Comma-separated room names to join on startup
CHATCOMMON_ROOMS=d_d,n_n

# ─── MumbleChat ────────────────────────────────────────────────────────────────
# Bot API key from your MumbleChat dashboard
MUMBLECHAT_BOT_KEY=

# MumbleChat server base URL (no trailing slash)
MUMBLECHAT_SERVER_URL=https://mumblechat.online

# Comma-separated room names to join on startup
MUMBLECHAT_ROOMS=hell

# ─── AI — Ollama (local, preferred) ────────────────────────────────────────────
# Base URL for your Ollama instance
OLLAMA_HOST=http://localhost:11434

# Model to use — dolphin3:8b is a good uncensored 8B model
OLLAMA_MODEL=dolphin3:8b

# ─── AI — Groq (cloud fallback, optional) ──────────────────────────────────────
# Leave blank to disable Groq. Used when Ollama is unreachable.
GROQ_API_KEY=

# ─── Identity ──────────────────────────────────────────────────────────────────
# Bot's display nick (what she appears as in chat)
OO_BOT_NICK=ó_ò

# Site owner's platform username (used for DMs and elevated permissions)
OO_OWNER_USERNAME=n_n

# Comma-separated nicks the owner might use in chat
OO_OWNER_NICKS=n_n,nn

# Comma-separated nicks of trusted mods (can use .mod commands)
OO_MOD_NICKS=

# ─── Storage ───────────────────────────────────────────────────────────────────
# Where to store JSON data files. Leave blank for auto-discovery:
#   Linux default: ~/.oo/data/
#   Fallback:      <script_dir>/oo_data/
OO_DATA_DIR=

# Optional Neon (or any asyncpg-compatible) Postgres URL.
# If set, important tables are async-synced to Postgres in addition to JSON.
# Format: postgresql://user:password@host/dbname
OO_PG_URL=

# ─── OSRS Companion ────────────────────────────────────────────────────────────
# Owner's Old School RuneScape account name (for hiscores checks and reactions)
OO_OSRS_OWNER_USERNAME=

# Hours (24h format, comma-separated) when ó_ò proactively invites n_n to play
# She still rolls a 35% chance + 1hr cooldown, so not every hour fires
OO_OSRS_INVITE_HOURS=18,19,20

# ─── Site Watch ────────────────────────────────────────────────────────────────
# Rooms to monitor for health and activity changes
OO_WATCH_ROOMS=d_d,n_n

# Mod actions in 10 minutes that trigger an immediate drama alert DM to owner
OO_DRAMA_THRESHOLD=3

# Hour (24h) to send the daily room + moderation activity summary to owner
OO_DAILY_SUMMARY_HOUR=23
